# Mnemos API Environment Variables
PROJECT_NAME="Mnemos API"
API_V1_STR="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://mnemos_user:mnemos_password@localhost:5432/mnemos_dev

# Security & JWT
JWT_SECRET=change_this_to_a_super_secure_random_string_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage

# AI Providers (Google Gemini API)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=5
